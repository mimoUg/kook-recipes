---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import RecipeCard from '../../components/recipes/RecipeCard.astro';
import {
    formatDate,
    getAllRecipes,
    getRecipeDate,
    getRecipeSlug,
    getSimilarRecipes,
    getStepImage,
    type Recipe,
} from '../../lib/recipes';
import { settings } from '../../lib/settings';

interface Props {
    recipe: Recipe;
}

export async function getStaticPaths() {
    const recipes = await getAllRecipes();

    return recipes.map((recipe) => ({
        params: { slug: getRecipeSlug(recipe) },
        props: { recipe },
    }));
}

const { recipe } = Astro.props as Props;
const { Content } = await render(recipe);
const data = recipe.data;
const allRecipes = await getAllRecipes();
const similarRecipes = getSimilarRecipes(recipe, allRecipes, 3);
const publishedDate = getRecipeDate(recipe);
const totalSteps = data.steps.length;

const totalTimeISO = (() => {
    const hours = /(\d+)\s*(h|hr|hour)/i.exec(data.totalTime)?.[1] ?? '0';
    const minutes = /(\d+)\s*(m|min|minute)/i.exec(data.totalTime)?.[1] ?? '0';
    if (hours === '0' && minutes === '0') return undefined;
    return `PT${hours !== '0' ? `${hours}H` : ''}${
        minutes !== '0' ? `${minutes}M` : ''
    }`;
})();

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Recipe',
    name: data.title,
    image: [data.coverImage],
    description: data.description,
    author: {
        '@type': 'Organization',
        name: settings.siteTitle,
    },
    datePublished: publishedDate?.toISOString().slice(0, 10),
    recipeYield: `${data.servings} servings`,
    totalTime: totalTimeISO,
    recipeCategory: data.categories,
    keywords: data.categories.join(', '),
    recipeIngredient: data.ingredients,
    recipeInstructions: data.steps.map((step, index) => ({
        '@type': 'HowToStep',
        position: index + 1,
        name: step.title,
        text: step.description,
        image: getStepImage(step.image),
    })),
};
---

<Layout
    title={data.title}
    description={data.description}
    image={data.coverImage}
    type="article"
>
    <article class="pb-14 lg:pb-20">
        <div class="container">
            <nav
                class="print-hidden flex flex-wrap items-center gap-1.5 pt-7 text-xs font-medium text-appGray-400"
                aria-label="Breadcrumb"
            >
                <a href="/" class="transition-colors hover:text-appAccent">
                    Home
                </a>
                <Icon name="chevron-right" class="h-3.5 w-3.5" />
                <a
                    href="/recipes"
                    class="transition-colors hover:text-appAccent"
                >
                    Recipes
                </a>
                <Icon name="chevron-right" class="h-3.5 w-3.5" />
                <span class="text-appGray-600">{data.title}</span>
            </nav>

            <div
                class="mt-5 overflow-hidden rounded-2xl bg-appGray-200 lg:mt-8"
            >
                <img
                    src={data.coverImage}
                    alt={data.coverAlt || data.title}
                    class="recipe-hero-image aspect-[16/10] w-full object-cover lg:aspect-[2.15]"
                    fetchpriority="high"
                />
            </div>

            <div class="mx-auto mt-8 max-w-4xl lg:mt-12">
                <div class="flex flex-wrap items-center gap-2">
                    {
                        data.categories.map((category) => (
                            <a
                                href={`/recipes?c=${encodeURIComponent(category)}`}
                                class="chip transition-colors hover:bg-appAccent hover:text-white"
                            >
                                {category}
                            </a>
                        ))
                    }
                    {
                        data.popular && (
                            <span class="inline-flex items-center gap-1.5 rounded-full bg-[#E8C27A]/20 px-3 py-1.5 text-xs font-semibold text-[#7A5A1E]">
                                <Icon name="star" class="h-3 w-3" />
                                Reader favourite
                            </span>
                        )
                    }
                </div>

                <h1
                    class="mt-4 text-3xl font-semibold leading-[1.08] tracking-[-0.035em] text-appGray-700 sm:text-4xl lg:text-5xl"
                >
                    {data.title}
                </h1>

                <div
                    class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-medium text-appGray-400 lg:text-sm"
                >
                    {
                        publishedDate && (
                            <span>Published {formatDate(publishedDate)}</span>
                        )
                    }
                    <span class="inline-flex items-center gap-1.5">
                        <Icon name="chef-hat" class="h-4 w-4" />
                        {data.difficulty}
                    </span>
                </div>

                <div class="mt-7 grid grid-cols-2 gap-3 sm:grid-cols-4">
                    <div
                        class="rounded-xl border border-[#E8E8E8] bg-white px-4 py-4"
                    >
                        <div
                            class="flex items-center gap-1.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-appGray-400"
                        >
                            <Icon name="clock" class="h-3.5 w-3.5" />
                            Total time
                        </div>
                        <div class="mt-2 text-lg font-semibold text-appGray-700">
                            {data.totalTime || '—'}
                        </div>
                    </div>
                    <div
                        class="rounded-xl border border-[#E8E8E8] bg-white px-4 py-4"
                    >
                        <div
                            class="flex items-center gap-1.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-appGray-400"
                        >
                            <Icon name="users" class="h-3.5 w-3.5" />
                            Serves
                        </div>
                        <div class="mt-2 text-lg font-semibold text-appGray-700">
                            {data.servings}
                        </div>
                    </div>
                    <div
                        class="rounded-xl border border-[#E8E8E8] bg-white px-4 py-4"
                    >
                        <div
                            class="flex items-center gap-1.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-appGray-400"
                        >
                            <Icon name="leaf" class="h-3.5 w-3.5" />
                            Ingredients
                        </div>
                        <div class="mt-2 text-lg font-semibold text-appGray-700">
                            {data.ingredients.length}
                        </div>
                    </div>
                    <div
                        class="rounded-xl border border-[#E8E8E8] bg-white px-4 py-4"
                    >
                        <div
                            class="flex items-center gap-1.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-appGray-400"
                        >
                            <Icon name="chef-hat" class="h-3.5 w-3.5" />
                            Steps
                        </div>
                        <div class="mt-2 text-lg font-semibold text-appGray-700">
                            {totalSteps}
                        </div>
                    </div>
                </div>

                <div class="mt-7 flex flex-wrap gap-3 print-hidden">
                    <Button
                        variant="dark"
                        onclick="window.print()"
                    >
                        <Icon name="print" class="h-4 w-4" />
                        Print / save PDF
                    </Button>
                    <Button href="/recipes" variant="outline">
                        <Icon name="arrow-left" class="h-4 w-4" />
                        All recipes
                    </Button>
                </div>

                <div class="recipe-body mt-10 lg:mt-12">
                    <Content />
                </div>
            </div>
        </div>
    </article>

    {
        data.faq.length > 0 && (
            <section class="border-y border-[#EFEBE6] bg-appGray-100 py-12 lg:py-20">
                <div class="container">
                    <div class="mx-auto max-w-4xl">
                        <p class="eyebrow mb-3">Before you cook</p>
                        <h2 class="text-2xl font-semibold tracking-[-0.03em] text-appGray-700 lg:text-3xl">
                            Questions &amp; answers
                        </h2>
                        <div class="mt-6 space-y-3">
                            {data.faq.map((item) => (
                                <details class="group rounded-xl border border-[#E5E2DE] bg-white">
                                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-sm font-semibold text-appGray-700 marker:hidden lg:text-base">
                                        {item.question}
                                        <Icon
                                            name="chevron-down"
                                            class="faq-chevron h-5 w-5 shrink-0 text-appGray-400 transition-transform duration-300"
                                        />
                                    </summary>
                                    <p class="px-5 pb-5 text-sm font-medium leading-relaxed text-appGray-500">
                                        {item.answer}
                                    </p>
                                </details>
                            ))}
                        </div>
                    </div>
                </div>
            </section>
        )
    }

    <section class="py-12 lg:py-20">
        <div class="container">
            <div
                class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16 xl:gap-24"
            >
                <div>
                    <p class="eyebrow mb-3">What you'll need</p>
                    <h2
                        class="text-2xl font-semibold tracking-[-0.03em] text-appGray-700 lg:text-3xl"
                    >
                        Ingredients
                    </h2>
                    <p class="mt-3 text-sm font-medium text-appGray-400">
                        For {data.servings} servings
                    </p>

                    <ul class="mt-6 grid gap-2 sm:grid-cols-2 lg:grid-cols-1">
                        {data.ingredients.map((ingredient) => (
                            <li>
                                <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-[#E8E8E8] px-4 py-3.5 transition-colors hover:border-appAccent/30">
                                    <input
                                        type="checkbox"
                                        class="peer mt-0.5 h-4 w-4 shrink-0 cursor-pointer rounded border-[#D6D6D6] accent-[#0A2213]"
                                    />
                                    <span class="text-sm font-medium leading-snug text-appGray-600 transition-colors peer-checked:text-appGray-400 peer-checked:line-through">
                                        {ingredient}
                                    </span>
                                </label>
                            </li>
                        ))}
                    </ul>
                </div>

                <div>
                    <p class="eyebrow mb-3">Step by step</p>
                    <h2
                        class="text-2xl font-semibold tracking-[-0.03em] text-appGray-700 lg:text-3xl"
                    >
                        Method
                    </h2>

                    <div class="mt-6" data-steps>
                        {
                            data.steps.map((step, index) => (
                                <div
                                    data-step-panel
                                    data-step-index={index}
                                    class:list={[
                                        index === 0 ? '' : 'hidden',
                                    ]}
                                >
                                    {getStepImage(step.image) && (
                                        <img
                                            src={getStepImage(step.image)}
                                            alt={step.title}
                                            loading="lazy"
                                            decoding="async"
                                            class="aspect-[16/10] w-full rounded-xl object-cover"
                                        />
                                    )}
                                    <div class="mt-4 flex items-start gap-3">
                                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-appAccent text-xs font-semibold text-white">
                                            {index + 1}
                                        </span>
                                        <h3 class="pt-1 text-lg font-semibold leading-snug tracking-[-0.02em] text-appGray-700">
                                            {step.title}
                                        </h3>
                                    </div>
                                    <p class="mt-3 text-sm font-medium leading-relaxed text-appGray-500 lg:text-base">
                                        {step.description}
                                    </p>
                                </div>
                            ))
                        }

                        <div class="recipe-steps-nav mt-7 print-hidden">
                            <div class="flex gap-1.5">
                                {data.steps.map((_, index) => (
                                    <button
                                        type="button"
                                        data-step-dot
                                        data-step-target={index}
                                        aria-label={`Go to step ${index + 1}`}
                                        class:list={[
                                            'h-1.5 flex-1 rounded-full transition-colors duration-300',
                                            index === 0
                                                ? 'bg-appAccent'
                                                : 'bg-[#EBEBEB]',
                                        ]}
                                    />
                                ))}
                            </div>

                            <div class="mt-5 flex items-center justify-between gap-3">
                                <button
                                    type="button"
                                    data-step-prev
                                    class="inline-flex items-center gap-1.5 rounded-lg border border-[#E5E2DE] px-3.5 py-2.5 text-xs font-semibold text-appGray-600 transition-colors hover:border-appAccent disabled:cursor-not-allowed disabled:opacity-40"
                                >
                                    <Icon
                                        name="arrow-left"
                                        class="h-3.5 w-3.5"
                                    />
                                    Previous
                                </button>
                                <span
                                    data-step-label
                                    class="text-xs font-semibold uppercase tracking-[0.12em] text-appGray-400"
                                >
                                    Step 1 of {totalSteps}
                                </span>
                                <button
                                    type="button"
                                    data-step-next
                                    class="inline-flex items-center gap-1.5 rounded-lg bg-appAccent px-3.5 py-2.5 text-xs font-semibold text-white transition-colors hover:bg-appGray-700 disabled:cursor-not-allowed disabled:opacity-40"
                                >
                                    Next
                                    <Icon
                                        name="arrow-right"
                                        class="h-3.5 w-3.5"
                                    />
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {
        similarRecipes.length > 0 && (
            <section class="border-t border-[#EFEBE6] bg-appGray-100 py-14 lg:py-20">
                <div class="container">
                    <div class="flex flex-wrap items-end justify-between gap-4">
                        <div>
                            <p class="eyebrow mb-3">Keep cooking</p>
                            <h2 class="text-2xl font-semibold tracking-[-0.03em] text-appGray-700 lg:text-3xl">
                                Other recipes you may like
                            </h2>
                        </div>
                        <a
                            href="/recipes"
                            class="inline-flex items-center gap-2 text-sm font-semibold text-appAccent transition-colors hover:text-appGray-500"
                        >
                            Show all
                            <Icon name="arrow-right" class="h-4 w-4" />
                        </a>
                    </div>

                    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                        {similarRecipes.map((similar) => (
                            <RecipeCard recipe={similar} />
                        ))}
                    </div>
                </div>
            </section>
        )
    }

    <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd)}
    />

    <script>
        const stepsRoot = document.querySelector<HTMLElement>('[data-steps]');

        if (stepsRoot) {
            const panels = Array.from(
                stepsRoot.querySelectorAll<HTMLElement>('[data-step-panel]'),
            );
            const dots = Array.from(
                stepsRoot.querySelectorAll<HTMLButtonElement>('[data-step-dot]'),
            );
            const prev = stepsRoot.querySelector<HTMLButtonElement>(
                '[data-step-prev]',
            );
            const next = stepsRoot.querySelector<HTMLButtonElement>(
                '[data-step-next]',
            );
            const label =
                stepsRoot.querySelector<HTMLElement>('[data-step-label]');
            let active = 0;

            const render = () => {
                panels.forEach((panel, index) => {
                    panel.classList.toggle('hidden', index !== active);
                });

                dots.forEach((dot, index) => {
                    dot.classList.toggle('bg-appAccent', index <= active);
                    dot.classList.toggle('bg-[#EBEBEB]', index > active);
                });

                if (prev) prev.disabled = active === 0;
                if (next) next.disabled = active === panels.length - 1;
                if (label) {
                    label.textContent = `Step ${active + 1} of ${panels.length}`;
                }
            };

            prev?.addEventListener('click', () => {
                active = Math.max(0, active - 1);
                render();
            });

            next?.addEventListener('click', () => {
                active = Math.min(panels.length - 1, active + 1);
                render();
            });

            dots.forEach((dot, index) => {
                dot.addEventListener('click', () => {
                    active = index;
                    render();
                });
            });

            render();
        }
    </script>
</Layout>
