---
import Layout from '../../layouts/Layout.astro';
import RecipeIndex from '../../components/recipes/RecipeIndex.astro';
import {
    getAllRecipes,
    getCategories,
    getRecipesForSection,
} from '../../lib/recipes';
import { settings } from '../../lib/settings';

const recipes = getRecipesForSection(await getAllRecipes(), 'eggplant');
const categories = getCategories(recipes);
---

<Layout
    title="Eggplant Recipes"
    description={`Hearty, flavorful eggplant recipes, from crispy fries to silky dips. Browse the ${settings.siteTitle} eggplant collection.`}
>
    <RecipeIndex
        eyebrow="Eggplant recipes"
        headingLead="Eggplant recipes,"
        headingAccent="every good way"
        recipes={recipes}
        categories={categories}
    />
</Layout>
