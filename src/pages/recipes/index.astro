---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/ui/Icon.astro';
import RecipeCard from '../../components/recipes/RecipeCard.astro';
import { getAllRecipes, getCategories } from '../../lib/recipes';
import { settings } from '../../lib/settings';

const recipes = await getAllRecipes();
const categories = getCategories(recipes);
const popularCount = recipes.filter((recipe) => recipe.data.popular).length;
---

<Layout
    title="Recipes"
    description={`Browse every recipe in the ${settings.siteTitle} collection — weeknight dinners, slow weekends, sweet things and everything in between.`}
>
    <section class="pb-16 pt-10 lg:pb-24 lg:pt-16">
        <div class="container">
            <div class="max-w-3xl">
                <p class="eyebrow mb-3">The recipe index</p>
                <h1
                    class="text-4xl font-semibold leading-[1.05] tracking-[-0.035em] text-appGray-700 sm:text-5xl lg:text-6xl"
                >
                    Find something
                    <span class="font-serif font-medium italic">delicious</span>
                </h1>
                <p
                    class="mt-5 max-w-2xl text-base font-medium leading-relaxed text-appGray-500 lg:text-lg"
                >
                    {recipes.length} recipes, {popularCount} reader favourites, and
                    plenty of reasons to stay in and cook tonight.
                </p>
            </div>

            <div
                class="mt-8 rounded-2xl border border-[#E5E2DE] bg-white p-4 shadow-sm lg:mt-12 lg:p-5"
            >
                <div class="grid gap-3 md:grid-cols-[1.6fr_1fr_1fr]">
                    <label class="relative block">
                        <span class="sr-only">Search recipes</span>
                        <Icon
                            name="search"
                            class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-appGray-400"
                        />
                        <input
                            data-recipe-search
                            type="search"
                            placeholder="Search recipes"
                            autocomplete="off"
                            class="field pl-11"
                        />
                    </label>

                    <label class="relative block">
                        <span class="sr-only">Filter by popularity</span>
                        <select
                            data-recipe-popular
                            class="field appearance-none pr-10"
                        >
                            <option value="all">All recipes</option>
                            <option value="__popular__">Popular recipes</option>
                        </select>
                        <Icon
                            name="chevron-down"
                            class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-appGray-400"
                        />
                    </label>

                    <label class="relative block">
                        <span class="sr-only">Filter by category</span>
                        <select
                            data-recipe-category
                            class="field appearance-none pr-10"
                        >
                            <option value="">All categories</option>
                            {categories.map((category) => (
                                <option value={category}>{category}</option>
                            ))}
                        </select>
                        <Icon
                            name="chevron-down"
                            class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-appGray-400"
                        />
                    </label>
                </div>

                <div
                    class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-[#F0EDE9] pt-4"
                >
                    <p class="text-xs font-medium text-appGray-400">
                        <span data-recipe-count aria-live="polite">
                            {recipes.length}
                        </span>
                        recipes
                    </p>
                    <button
                        type="button"
                        data-recipe-reset
                        class="text-xs font-semibold uppercase tracking-[0.12em] text-appGray-400 transition-colors hover:text-appAccent"
                    >
                        Clear filters
                    </button>
                </div>
            </div>

            <div
                data-recipe-grid
                class="mt-8 grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:mt-12 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-14"
            >
                {recipes.map((recipe) => <RecipeCard recipe={recipe} />)}
            </div>

            <div
                data-recipe-empty
                class="hidden rounded-2xl border border-dashed border-[#D9D4CE] px-6 py-16 text-center"
            >
                <p class="text-lg font-semibold text-appGray-700">
                    No recipes match those filters
                </p>
                <p class="mt-2 text-sm font-medium text-appGray-400">
                    Try a different search or clear the filters to see everything.
                </p>
            </div>
        </div>
    </section>

    <script>
        const searchInput =
            document.querySelector<HTMLInputElement>('[data-recipe-search]');
        const popularSelect =
            document.querySelector<HTMLSelectElement>('[data-recipe-popular]');
        const categorySelect =
            document.querySelector<HTMLSelectElement>('[data-recipe-category]');
        const countLabel =
            document.querySelector<HTMLElement>('[data-recipe-count]');
        const resetButton =
            document.querySelector<HTMLButtonElement>('[data-recipe-reset]');
        const grid = document.querySelector<HTMLElement>('[data-recipe-grid]');
        const empty = document.querySelector<HTMLElement>('[data-recipe-empty]');
        const cards = Array.from(
            document.querySelectorAll<HTMLElement>('[data-recipe-card]'),
        );

        if (
            searchInput &&
            popularSelect &&
            categorySelect &&
            countLabel &&
            grid &&
            empty
        ) {
            const params = new URLSearchParams(window.location.search);

            searchInput.value = params.get('s') ?? '';
            popularSelect.value =
                params.get('p') === '__popular__' ? '__popular__' : 'all';
            categorySelect.value = params.get('c') ?? '';

            const applyFilters = (updateUrl = true) => {
                const query = searchInput.value.trim().toLowerCase();
                const popular = popularSelect.value;
                const category = categorySelect.value;
                let visibleCount = 0;

                cards.forEach((card) => {
                    const title = (card.dataset.title || '').toLowerCase();
                    const description = (
                        card.dataset.description || ''
                    ).toLowerCase();
                    const ingredients = (
                        card.dataset.ingredients || ''
                    ).toLowerCase();
                    const categories = (card.dataset.categories || '')
                        .split('|')
                        .filter(Boolean);
                    const isPopular = card.dataset.popular === 'true';

                    const matchesSearch =
                        !query ||
                        title.includes(query) ||
                        description.includes(query) ||
                        ingredients.includes(query) ||
                        categories.some((item) =>
                            item.toLowerCase().includes(query),
                        );

                    const matchesPopular =
                        popular === 'all' ||
                        (popular === '__popular__' && isPopular);
                    const matchesCategory =
                        !category || categories.includes(category);

                    const visible =
                        matchesSearch && matchesPopular && matchesCategory;

                    card.classList.toggle('hidden', !visible);
                    if (visible) visibleCount += 1;
                });

                countLabel.textContent = String(visibleCount);
                grid.classList.toggle('hidden', visibleCount === 0);
                empty.classList.toggle('hidden', visibleCount > 0);

                if (updateUrl) {
                    const next = new URLSearchParams();
                    const queryValue = searchInput.value.trim();

                    if (queryValue) next.set('s', queryValue);
                    if (popular === '__popular__') {
                        next.set('p', '__popular__');
                    }
                    if (category) next.set('c', category);

                    const search = next.toString();
                    history.replaceState(
                        null,
                        '',
                        search
                            ? `${window.location.pathname}?${search}`
                            : window.location.pathname,
                    );
                }
            };

            searchInput.addEventListener('input', () => applyFilters());
            popularSelect.addEventListener('change', () => applyFilters());
            categorySelect.addEventListener('change', () => applyFilters());

            resetButton?.addEventListener('click', () => {
                searchInput.value = '';
                popularSelect.value = 'all';
                categorySelect.value = '';
                applyFilters();
            });

            applyFilters(false);
        }
    </script>
</Layout>
