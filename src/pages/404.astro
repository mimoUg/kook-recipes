---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
---

<Layout
    title="Page not found"
    description="That page has gone missing from the recipe box."
    noindex
>
    <section class="flex flex-1 items-center py-20 lg:py-28">
        <div class="container">
            <div class="mx-auto max-w-xl text-center">
                <span
                    class="inline-flex items-center rounded-full bg-appAccent px-4 py-2 text-xs font-medium uppercase tracking-[0.18em] text-appText"
                >
                    Off the menu
                </span>
                <p
                    class="mt-6 text-7xl font-medium tracking-[-0.06em] text-appGray-200 sm:text-8xl"
                >
                    404
                </p>
                <h1
                    class="mt-2 text-3xl font-medium tracking-[-0.04em] text-appText sm:text-4xl"
                >
                    This page is off the menu
                </h1>
                <p
                    class="mx-auto mt-4 max-w-md text-sm font-normal leading-relaxed text-appGray-500 lg:text-base"
                >
                    The page you were looking for has been moved, eaten, or
                    never existed. Let's get you back to something delicious.
                </p>
                <div class="mt-8 flex flex-wrap justify-center gap-3">
                    <Button href="/recipes" variant="dark" size="lg">
                        Browse recipes
                        <Icon name="arrow-right" class="h-5 w-5" />
                    </Button>
                    <Button href="/" variant="outline" size="lg">
                        Back home
                    </Button>
                </div>
            </div>
        </div>
    </section>
</Layout>
