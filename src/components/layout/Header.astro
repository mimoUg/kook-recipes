---
import Logo from './Logo.astro';
import Icon from '../ui/Icon.astro';

const pathname = Astro.url.pathname;

const links = [
    { label: 'Home', href: '/' },
    { label: 'Recipes', href: '/recipes' },
    { label: 'About', href: '/#about' },
    { label: 'Contact', href: '/#contact' },
];

const isActive = (href: string) => {
    if (href === '/') return pathname === '/';
    if (href === '/recipes') return pathname.startsWith('/recipes');
    return false;
};
---

<header class="print-hidden relative z-50">
    <div class="container">
        <nav
            class="flex items-center justify-between gap-6 py-6"
            aria-label="Main"
        >
            <Logo />

            <div class="hidden items-center gap-7 md:flex lg:gap-10">
                {
                    links.map((link) => (
                        <a
                            href={link.href}
                            class:list={[
                                'relative text-base font-medium leading-none tracking-[-0.03em] text-appText transition-opacity hover:opacity-60 lg:text-xl',
                                isActive(link.href)
                                    ? 'after:absolute after:-bottom-2 after:left-0 after:h-0.5 after:w-full after:bg-appAccent after:content-[""]'
                                    : '',
                            ]}
                            aria-current={isActive(link.href) ? 'page' : undefined}
                        >
                            {link.label}
                        </a>
                    ))
                }
            </div>

            <button
                type="button"
                data-menu-toggle
                aria-expanded="false"
                aria-controls="mobile-menu"
                class="flex h-10 w-10 items-center justify-center rounded-full border border-appGray-100 text-appText transition-colors hover:border-appText md:hidden"
            >
                <Icon name="menu" class="h-5 w-5" data-icon-open />
                <Icon name="x" class="hidden h-5 w-5" data-icon-close />
                <span class="sr-only">Toggle menu</span>
            </button>
        </nav>

        <div id="mobile-menu" data-mobile-menu class="hidden pb-5 md:hidden">
            <nav
                class="flex flex-col rounded-2xl border border-appGray-200 bg-white p-2 shadow-float"
                aria-label="Mobile"
            >
                {
                    links.map((link) => (
                        <a
                            href={link.href}
                            class:list={[
                                'rounded-xl px-4 py-3 text-lg font-medium tracking-[-0.03em] text-appText transition-colors hover:bg-appGray-100',
                                isActive(link.href) ? 'bg-appAccent' : '',
                            ]}
                            data-mobile-link
                            aria-current={
                                isActive(link.href) ? 'page' : undefined
                            }
                        >
                            {link.label}
                        </a>
                    ))
                }
            </nav>
        </div>
    </div>
</header>

<script>
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
    const openIcon = document.querySelector<HTMLElement>('[data-icon-open]');
    const closeIcon = document.querySelector<HTMLElement>('[data-icon-close]');

    if (toggle && menu && openIcon && closeIcon) {
        const setOpen = (open: boolean) => {
            toggle.setAttribute('aria-expanded', String(open));
            menu.classList.toggle('hidden', !open);
            openIcon.classList.toggle('hidden', open);
            closeIcon.classList.toggle('hidden', !open);
        };

        toggle.addEventListener('click', () => {
            setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });

        document.querySelectorAll('[data-mobile-link]').forEach((link) => {
            link.addEventListener('click', () => setOpen(false));
        });
    }
</script>
