---
import { settings } from '../../lib/settings';

interface Props {
    variant?: 'light' | 'dark';
    class?: string;
    href?: string;
}

const {
    variant = 'dark',
    class: className = '',
    href = '/',
} = Astro.props;
---

<a
    href={href}
    class:list={[
        'inline-flex items-center gap-2.5 transition-opacity duration-300 hover:opacity-80',
        variant === 'light' ? 'text-white' : 'text-appAccent',
        className,
    ]}
    aria-label={`${settings.siteTitle} home`}
>
    <svg viewBox="0 0 40 40" class="h-9 w-9 shrink-0" aria-hidden="true">
        <rect
            width="40"
            height="40"
            rx="12"
            class={variant === 'light' ? 'fill-appGray-100' : 'fill-appAccent'}
        />
        <path
            d="M29 9c-8.5 0-14 4.5-14 11a6.5 6.5 0 0 0 6.5 6.5C28 26.5 29 19 29 9Z"
            class={variant === 'light' ? 'fill-appAccent' : 'fill-appGray-100'}
        />
        <path
            d="M9 31c4-5 8.5-8 14-10"
            fill="none"
            stroke-width="2"
            stroke-linecap="round"
            class={variant === 'light' ? 'stroke-appAccent' : 'stroke-appGray-100'}
        />
    </svg>
    <span class="text-[19px] font-semibold tracking-[-0.03em]">
        {settings.siteTitle}
    </span>
</a>
