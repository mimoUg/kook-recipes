---
import Logo from './Logo.astro';
import Icon from '../ui/Icon.astro';
import { settings } from '../../lib/settings';

const year = new Date().getFullYear();
---

<footer class="print-hidden relative z-10 pb-6">
    <div class="container">
        <div class="rounded-2xl bg-appAccent p-5 pb-6 text-appText lg:p-10">
            <div
                class="border-b border-[#B2CF81] pb-6 md:flex md:items-end md:justify-between md:gap-12 md:pb-10 lg:pb-16"
            >
                <p
                    class="max-w-[520px] text-[28px] font-semibold leading-[1.08] tracking-[-0.04em] md:text-4xl lg:text-[48px] xl:text-[56px]"
                >
                    {settings.footer.description}
                </p>
                <div class="mt-6 flex flex-wrap gap-3 md:mt-0 md:justify-end">
                    <a
                        href="/recipes"
                        class="inline-flex items-center gap-2 rounded-full bg-appText px-5 py-3 text-sm font-medium leading-none text-white transition-colors hover:bg-appText/85"
                    >
                        Browse recipes
                        <Icon name="arrow-right" class="h-4 w-4" />
                    </a>
                    <a
                        href={`mailto:${settings.contact.email}`}
                        class="inline-flex items-center gap-2 rounded-full border border-appText/20 px-5 py-3 text-sm font-medium leading-none text-appText transition-colors hover:border-appText/50"
                    >
                        <Icon name="mail" class="h-4 w-4" />
                        Say hello
                    </a>
                </div>
            </div>

            <div
                class="flex flex-col gap-9 pt-7 md:flex-row md:justify-between md:gap-12 md:pt-8"
            >
                <div class="max-w-xs">
                    <Logo />
                    <p
                        class="mt-4 text-sm font-medium leading-relaxed text-appText/70"
                    >
                        {settings.siteDescription}
                    </p>
                    <a
                        href="/keystatic"
                        class="mt-5 inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.16em] text-appText/70 transition-colors hover:text-appText"
                    >
                        <Icon name="leaf" class="h-4 w-4" />
                        Write a recipe
                    </a>
                </div>

                <nav
                    class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:justify-items-end"
                    aria-label="Footer"
                >
                    {
                        settings.footer.columns.map((column) => (
                            <div>
                                <h2 class="mb-4 text-[11px] font-medium uppercase tracking-[0.16em] text-appText/55">
                                    {column.title}
                                </h2>
                                <ul class="space-y-3">
                                    {column.links.map((link) => (
                                        <li>
                                            <a
                                                href={link.href}
                                                class="text-sm font-medium text-appText transition-opacity hover:opacity-60"
                                            >
                                                {link.label}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))
                    }
                    <div>
                        <h2 class="mb-4 text-[11px] font-medium uppercase tracking-[0.16em] text-appText/55">
                            Say hello
                        </h2>
                        <a
                            href={`mailto:${settings.contact.email}`}
                            class="inline-flex items-center gap-2 text-sm font-medium text-appText transition-opacity hover:opacity-60"
                        >
                            <Icon name="mail" class="h-4 w-4" />
                            Email us
                        </a>
                    </div>
                </nav>
            </div>

            <div
                class="mt-9 flex flex-col gap-3 border-t border-[#B2CF81] pt-5 text-xs font-medium text-appText/65 sm:flex-row sm:items-center sm:justify-between"
            >
                <p>
                    &copy; {year} {settings.siteTitle}. All rights reserved.
                </p>
                <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
                    <a
                        href="/legal"
                        class="transition-colors hover:text-appText"
                    >
                        Legal
                    </a>
                    <span>Built with Astro &amp; Keystatic</span>
                </div>
            </div>
        </div>
    </div>
</footer>
