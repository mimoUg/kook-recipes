---
import Logo from './Logo.astro';
import Icon from '../ui/Icon.astro';
import { settings } from '../../lib/settings';

const year = new Date().getFullYear();
---

<footer class="print-hidden bg-appGray-100 pb-8 pt-10 lg:pt-16">
    <div class="container">
        <div
            class="grid gap-10 border-b border-[#E5E2DE] pb-10 lg:grid-cols-[1.1fr_1fr] lg:gap-16 lg:pb-14"
        >
            <div class="max-w-sm">
                <Logo variant="dark" />
                <p class="mt-4 text-sm font-medium leading-relaxed text-appGray-500">
                    {settings.footer.description}
                </p>
                <a
                    href="/keystatic"
                    class="mt-6 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-appGray-500 transition-colors hover:text-appAccent"
                >
                    <Icon name="leaf" class="h-4 w-4" />
                    Write a recipe
                </a>
            </div>

            <nav
                class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:justify-items-end"
                aria-label="Footer"
            >
                {
                    settings.footer.columns.map((column) => (
                        <div>
                            <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.16em] text-appGray-500">
                                {column.title}
                            </h2>
                            <ul class="space-y-3">
                                {column.links.map((link) => (
                                    <li>
                                        <a
                                            href={link.href}
                                            class="text-sm font-medium text-appAccent transition-colors hover:text-appGray-500"
                                        >
                                            {link.label}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
                <div>
                    <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.16em] text-appGray-500">
                        Say hello
                    </h2>
                    <a
                        href={`mailto:${settings.contact.email}`}
                        class="inline-flex items-center gap-2 text-sm font-medium text-appAccent transition-colors hover:text-appGray-500"
                    >
                        <Icon name="mail" class="h-4 w-4" />
                        Email us
                    </a>
                </div>
            </nav>
        </div>

        <div
            class="flex flex-col gap-3 pt-6 text-xs font-medium text-appGray-500 sm:flex-row sm:items-center sm:justify-between"
        >
            <p>&copy; {year} {settings.siteTitle}. All rights reserved.</p>
            <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
                <a href="/legal" class="transition-colors hover:text-appAccent">
                    Legal
                </a>
                <span>Built with Astro &amp; Keystatic</span>
            </div>
        </div>
    </div>
</footer>
