---
type Variant = 'light' | 'dark' | 'gray' | 'outline' | 'white' | 'ghost';
type Size = 'sm' | 'regular' | 'lg';

interface Props {
    href?: string;
    variant?: Variant;
    size?: Size;
    class?: string;
    type?: 'button' | 'submit' | 'reset';
    disabled?: boolean;
    [key: string]: unknown;
}

const {
    href,
    variant = 'light',
    size = 'regular',
    class: className = '',
    type = 'button',
    disabled = false,
    ...rest
} = Astro.props;

const base =
    'inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full border border-transparent font-medium leading-none tracking-[-0.01em] transition-colors duration-300 focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50';

const variants: Record<Variant, string> = {
    light: 'bg-appAccent text-appText hover:bg-appAccent-dark',
    dark: 'bg-appText text-white hover:bg-appText/85',
    gray: 'bg-[#F2F2F2] text-appText hover:bg-appGray-100',
    outline:
        'border-appGray-300 bg-transparent text-appText hover:border-appText hover:bg-appText hover:text-white',
    white: 'bg-white text-appText hover:bg-appGray-100',
    ghost: 'bg-transparent text-appText hover:opacity-60',
};

const sizes: Record<Size, string> = {
    sm: 'px-4 py-2.5 text-xs',
    regular: 'px-5 py-3 text-sm',
    lg: 'px-7 py-4 text-base',
};

const classes = [base, variants[variant], sizes[size], className].join(' ');
---

{
    href ? (
        <a href={href} class={classes} {...rest}>
            <slot />
        </a>
    ) : (
        <button type={type} class={classes} disabled={disabled} {...rest}>
            <slot />
        </button>
    )
}
