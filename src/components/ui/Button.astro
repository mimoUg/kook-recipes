---
type Variant = 'light' | 'dark' | 'gray' | 'outline' | 'white' | 'ghost';
type Size = 'sm' | 'regular' | 'lg';

interface Props {
    href?: string;
    variant?: Variant;
    size?: Size;
    class?: string;
    type?: 'button' | 'submit' | 'reset';
    disabled?: boolean;
    [key: string]: unknown;
}

const {
    href,
    variant = 'light',
    size = 'regular',
    class: className = '',
    type = 'button',
    disabled = false,
    ...rest
} = Astro.props;

const base =
    'inline-flex items-center justify-center gap-2 whitespace-nowrap border border-transparent font-medium leading-none transition-colors duration-300 focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50';

const variants: Record<Variant, string> = {
    light: 'bg-appGray-200 text-appAccent hover:bg-white hover:shadow-float',
    dark: 'bg-appAccent text-white hover:bg-appGray-700',
    gray: 'bg-[#F2F2F2] text-appGray-600 hover:border-appAccent',
    outline:
        'border-appAccent/15 bg-transparent text-appAccent hover:bg-appAccent hover:text-white',
    white: 'bg-white text-appAccent hover:bg-appGray-100 hover:shadow-float',
    ghost: 'bg-transparent text-appAccent hover:text-appGray-500',
};

const sizes: Record<Size, string> = {
    sm: 'rounded-lg px-4 py-2.5 text-xs',
    regular: 'rounded-lg px-5 py-3 text-sm',
    lg: 'rounded-xl px-7 py-4 text-base',
};

const classes = [base, variants[variant], sizes[size], className].join(' ');
---

{
    href ? (
        <a href={href} class={classes} {...rest}>
            <slot />
        </a>
    ) : (
        <button type={type} class={classes} disabled={disabled} {...rest}>
            <slot />
        </button>
    )
}
