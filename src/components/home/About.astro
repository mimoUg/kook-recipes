---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { settings } from '../../lib/settings';
---

<section id="about" class="scroll-mt-28 pb-16 lg:pb-24">
    <div class="container">
        <div
            class="grid items-center gap-8 md:gap-10 lg:grid-cols-[1fr_1fr] lg:gap-16 xl:gap-24"
        >
            <div class="relative overflow-hidden rounded-2xl bg-appGray-100">
                {
                    settings.about.image && (
                        <img
                            src={settings.about.image}
                            alt=""
                            loading="lazy"
                            decoding="async"
                            class="aspect-[4/3] w-full object-cover lg:aspect-[1.05]"
                        />
                    )
                }
                <span
                    class="absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-appAccent px-3 py-2 text-[11px] font-medium uppercase leading-none tracking-[0.12em] text-appText lg:left-6 lg:top-6"
                >
                    <Icon name="leaf" class="h-3.5 w-3.5" />
                    Our kitchen
                </span>
            </div>

            <div>
                <p class="eyebrow">About us</p>
                <h2
                    class="mt-3 text-3xl font-medium leading-[1.08] tracking-[-0.04em] text-appText md:text-4xl lg:text-5xl"
                >
                    {settings.about.title}
                </h2>
                <p
                    class="mt-5 max-w-xl text-sm font-normal leading-relaxed tracking-[-0.01em] text-appGray-500 md:text-base lg:text-lg"
                >
                    {settings.about.description}
                </p>

                <div
                    class="mt-8 grid grid-cols-3 gap-4 border-t border-appGray-200 pt-6 lg:mt-10 lg:pt-8"
                >
                    {
                        settings.about.stats.map((stat) => (
                            <div>
                                <div class="text-2xl font-medium tracking-[-0.04em] text-appText md:text-3xl lg:text-4xl">
                                    {stat.value}
                                </div>
                                <div class="mt-1.5 text-xs font-normal leading-snug text-appGray-500 lg:text-sm">
                                    {stat.label}
                                </div>
                            </div>
                        ))
                    }
                </div>

                <Button href="/recipes" variant="dark" class="mt-8">
                    Find a recipe
                    <Icon name="arrow-right" class="h-4 w-4" />
                </Button>
            </div>
        </div>
    </div>
</section>
