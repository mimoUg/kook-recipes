---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import SearchForm from '../recipes/SearchForm.astro';
import { formatAccentText, settings } from '../../lib/settings';
import {
    formatDate,
    getRecipeDate,
    getRecipeSlug,
    type Recipe,
} from '../../lib/recipes';

interface Props {
    recipes: Recipe[];
}

const { recipes } = Astro.props;
const featured = recipes.slice(0, 3);
---

<section class="relative pb-8 pt-10 md:py-[72px] lg:pb-[100px] xl:pb-[128px]">
    <div class="container">
        <div
            class="mb-8 flex flex-col items-center gap-2.5 text-center md:mb-10 md:gap-4 lg:mb-12 lg:gap-5"
        >
            <p
                class="text-sm leading-none tracking-[-0.03em] text-appGray-500 md:text-base lg:text-xl"
            >
                {settings.hero.description}
            </p>
            <h1
                class="max-w-4xl text-4xl font-medium leading-[1.05] tracking-[-0.04em] text-appText sm:text-5xl md:text-6xl lg:text-[56px] xl:text-[64px]"
                set:html={formatAccentText(settings.hero.headline)}
            />
        </div>

        <SearchForm
            class="mx-auto mb-8 max-w-[848px] md:mb-12 lg:mb-16"
            placeholder="Search for a recipe"
        />

        {
            featured.length > 0 ? (
                <div class="grid auto-rows-fr grid-cols-2 gap-4 md:gap-6 lg:gap-8">
                    {featured.map((recipe, index) => {
                        const title = recipe.data.title || 'Untitled recipe';
                        const date = getRecipeDate(recipe);
                        const isWide =
                            featured.length === 1 ||
                            (featured.length === 3 && index === 2);
                        const summary =
                            recipe.data.description ||
                            recipe.data.categories.join(' · ');

                        return (
                            <a
                                href={`/recipes/${getRecipeSlug(recipe)}`}
                                class:list={[
                                    'group relative overflow-hidden rounded-xl bg-appGray-200 md:rounded-2xl',
                                    isWide
                                        ? 'col-span-2 aspect-[1.7] lg:aspect-[2.4]'
                                        : 'aspect-square lg:aspect-[1.17]',
                                ]}
                            >
                                {recipe.data.coverImage ? (
                                    <img
                                        src={recipe.data.coverImage}
                                        alt={recipe.data.coverAlt || title}
                                        loading={
                                            index === 0 ? 'eager' : 'lazy'
                                        }
                                        fetchpriority={
                                            index === 0 ? 'high' : undefined
                                        }
                                        decoding="async"
                                        class="absolute inset-0 h-full w-full object-cover transition duration-700 ease-out group-hover:scale-[1.03]"
                                    />
                                ) : (
                                    <div class="absolute inset-0 flex items-center justify-center text-appGray-400">
                                        <Icon
                                            name="chef-hat"
                                            class="h-12 w-12"
                                        />
                                    </div>
                                )}
                                <div class="absolute inset-0 bg-black/40 transition-colors duration-300 group-hover:bg-black/50" />

                                <div class="relative z-10 flex h-full flex-col p-4 md:p-6 lg:p-8 xl:p-10">
                                    <h2 class="text-base font-medium leading-tight tracking-[-0.03em] text-white group-hover:underline md:text-xl lg:text-2xl xl:text-[32px]">
                                        {title}
                                    </h2>

                                    <div class="mt-auto flex items-end justify-between gap-4 pt-6">
                                        <p class="line-clamp-2 max-w-[220px] text-xs leading-[1.3] tracking-[-0.02em] text-white/85 md:max-w-[320px] md:text-sm lg:max-w-[420px] lg:text-base">
                                            {summary}
                                        </p>
                                        {date && (
                                            <span class="shrink-0 text-xs font-medium leading-none tracking-[-0.02em] text-white/80 md:text-sm">
                                                {formatDate(date)}
                                            </span>
                                        )}
                                    </div>
                                </div>
                            </a>
                        );
                    })}
                </div>
            ) : (
                <div class="relative min-h-[320px] overflow-hidden rounded-2xl bg-appGray-200 lg:min-h-[440px]">
                    <img
                        src={settings.hero.image}
                        alt=""
                        fetchpriority="high"
                        class="absolute inset-0 h-full w-full object-cover"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/10" />
                    <div class="relative z-10 flex min-h-[320px] flex-col justify-end p-6 sm:p-8 lg:min-h-[440px] lg:p-12">
                        <p class="text-xs font-medium uppercase tracking-[0.18em] text-white/70">
                            Coming to the table
                        </p>
                        <h2 class="mt-3 max-w-xl text-2xl font-medium leading-[1.1] tracking-[-0.04em] text-white sm:text-3xl lg:text-[40px]">
                            The recipe box is just getting started.
                        </h2>
                        <p class="mt-3 max-w-lg text-sm font-normal leading-relaxed text-white/75 lg:text-base">
                            New recipes will appear here as they are added to
                            the kitchen. In the meantime, take a look around.
                        </p>
                        <div class="mt-6 flex flex-wrap gap-3">
                            <Button href="/recipes" variant="light">
                                Visit the recipe index
                                <Icon name="arrow-right" class="h-4 w-4" />
                            </Button>
                        </div>
                    </div>
                </div>
            )
        }
    </div>
</section>
