---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { settings } from '../../lib/settings';
---

<section id="contact" class="scroll-mt-28 pb-16 lg:pb-28">
    <div class="container">
        <div
            class="grid gap-8 rounded-2xl border border-appGray-200 bg-white p-5 md:p-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16 lg:p-12"
        >
            <div>
                <p class="eyebrow">Get in touch</p>
                <h2
                    class="mt-3 text-3xl font-medium leading-[1.08] tracking-[-0.04em] text-appText md:text-4xl lg:text-5xl"
                >
                    {settings.contact.title}
                </h2>
                <p
                    class="mt-5 max-w-lg text-sm font-normal leading-relaxed tracking-[-0.01em] text-appGray-500 md:text-base lg:text-lg"
                >
                    {settings.contact.description}
                </p>

                <div class="mt-8 space-y-3">
                    {
                        settings.contact.phone && (
                            <a
                                href={`tel:${settings.contact.phone.replace(
                                    /[^\d+]/g,
                                    '',
                                )}`}
                                class="flex items-center gap-4 rounded-xl border border-appGray-200 p-4 transition-colors hover:border-appText"
                            >
                                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-appAccent text-appText">
                                    <Icon name="phone" class="h-5 w-5" />
                                </span>
                                <span>
                                    <span class="block text-[10px] font-medium uppercase tracking-[0.16em] text-appGray-400">
                                        Telephone
                                    </span>
                                    <span class="mt-1 block text-sm font-medium text-appText">
                                        {settings.contact.phone}
                                    </span>
                                </span>
                            </a>
                        )
                    }

                    <a
                        href={`mailto:${settings.contact.email}`}
                        class="flex items-center gap-4 rounded-xl border border-appGray-200 p-4 transition-colors hover:border-appText"
                    >
                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-appAccent text-appText">
                            <Icon name="mail" class="h-5 w-5" />
                        </span>
                        <span>
                            <span class="block text-[10px] font-medium uppercase tracking-[0.16em] text-appGray-400">
                                Email
                            </span>
                            <span class="mt-1 block text-sm font-medium text-appText">
                                {settings.contact.email}
                            </span>
                        </span>
                    </a>
                </div>
            </div>

            <form
                data-contact-form
                data-contact-email={settings.contact.email}
                class="rounded-2xl bg-appAccent/30 p-5 md:p-6 lg:p-8"
            >
                <div class="grid gap-4">
                    <div>
                        <label
                            for="contact-name"
                            class="mb-2 block text-[11px] font-medium uppercase tracking-[0.14em] text-appGray-500"
                        >
                            Full name
                        </label>
                        <input
                            id="contact-name"
                            name="name"
                            type="text"
                            required
                            autocomplete="name"
                            placeholder="Your name"
                            class="field"
                        />
                    </div>
                    <div>
                        <label
                            for="contact-email"
                            class="mb-2 block text-[11px] font-medium uppercase tracking-[0.14em] text-appGray-500"
                        >
                            Email
                        </label>
                        <input
                            id="contact-email"
                            name="email"
                            type="email"
                            required
                            autocomplete="email"
                            placeholder="you@example.com"
                            class="field"
                        />
                    </div>
                    <div>
                        <label
                            for="contact-message"
                            class="mb-2 block text-[11px] font-medium uppercase tracking-[0.14em] text-appGray-500"
                        >
                            Question
                        </label>
                        <textarea
                            id="contact-message"
                            name="message"
                            required
                            rows="5"
                            placeholder="What would you like to ask?"
                            class="field resize-none"
                        ></textarea>
                    </div>
                </div>

                <Button type="submit" variant="dark" class="mt-5 w-full">
                    Send message
                    <Icon name="arrow-right" class="h-4 w-4" />
                </Button>
                <p
                    data-contact-note
                    class="mt-3 text-center text-xs font-medium text-appGray-500"
                >
                    This opens your email app with the message ready to send.
                </p>
            </form>
        </div>
    </div>
</section>

<script>
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    const note = document.querySelector<HTMLElement>('[data-contact-note]');

    form?.addEventListener('submit', (event) => {
        event.preventDefault();

        const data = new FormData(form);
        const name = String(data.get('name') || '').trim();
        const email = String(data.get('email') || '').trim();
        const message = String(data.get('message') || '').trim();
        const to = form.dataset.contactEmail || '';

        if (!name || !email || !message) return;

        const subject = encodeURIComponent(`Recipe question from ${name}`);
        const body = encodeURIComponent(
            `${message}\n\nFrom: ${name} (${email})`,
        );

        window.location.href = `mailto:${to}?subject=${subject}&body=${body}`;

        if (note) {
            note.textContent =
                'Opening your email app… if nothing happens, email us directly.';
        }
    });
</script>
