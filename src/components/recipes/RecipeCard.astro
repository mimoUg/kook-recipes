---
import Icon from '../ui/Icon.astro';
import {
    formatDate,
    getRecipeDate,
    getRecipeSlug,
    type Recipe,
} from '../../lib/recipes';

interface Props {
    recipe: Recipe;
    class?: string;
    showDate?: boolean;
}

const { recipe, class: className = '', showDate = false } = Astro.props;
const { data } = recipe;
const slug = getRecipeSlug(recipe);
const date = getRecipeDate(recipe);
---

<article
    class:list={['group h-full', className]}
    data-recipe-card
    data-title={data.title}
    data-description={data.description}
    data-categories={data.categories.join('|')}
    data-popular={String(data.popular)}
    data-ingredients={data.ingredients.join(' ')}
>
    <a href={`/recipes/${slug}`} class="flex h-full flex-col">
        <div class="relative overflow-hidden rounded-2xl bg-appGray-200">
            <img
                src={data.coverImage}
                alt={data.coverAlt || data.title}
                loading="lazy"
                decoding="async"
                class="aspect-square w-full object-cover transition duration-500 ease-out group-hover:scale-[1.035]"
            />
            <div
                class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/35 via-black/0 to-black/0 opacity-70 transition-opacity duration-300 group-hover:opacity-100"
            >
            </div>

            {
                data.popular && (
                    <span class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.08em] text-appAccent shadow-sm backdrop-blur">
                        <Icon name="star" class="h-3 w-3" />
                        Popular
                    </span>
                )
            }

            <span
                class="absolute bottom-3 right-3 flex h-10 w-10 items-center justify-center rounded-full bg-white text-appAccent opacity-0 shadow-float transition-all duration-300 group-hover:opacity-100"
                aria-hidden="true"
            >
                <Icon name="arrow-right" class="h-4 w-4" />
            </span>
        </div>

        <div class="flex flex-1 flex-col pt-4">
            {
                data.categories.length > 0 && (
                    <div class="mb-3 flex flex-wrap gap-2">
                        {data.categories.slice(0, 3).map((category) => (
                            <span class="chip">{category}</span>
                        ))}
                    </div>
                )
            }

            <h3
                class="text-xl font-semibold leading-snug tracking-[-0.02em] text-appGray-700 transition-colors group-hover:text-appAccent lg:text-[22px]"
            >
                {data.title}
            </h3>

            <p class="mt-2 line-clamp-2 text-sm font-medium leading-relaxed text-appGray-500">
                {data.description}
            </p>

            {
                showDate && date && (
                    <p class="mt-3 text-xs font-medium text-appGray-400">
                        {formatDate(date)}
                    </p>
                )
            }

            <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-2 pt-4 text-xs font-medium text-appGray-400">
                {data.totalTime && (
                    <span class="inline-flex items-center gap-1.5">
                        <Icon name="clock" class="h-4 w-4" />
                        {data.totalTime}
                    </span>
                )}
                <span class="inline-flex items-center gap-1.5">
                    <Icon name="users" class="h-4 w-4" />
                    {data.servings} servings
                </span>
                <span class="inline-flex items-center gap-1.5">
                    <Icon name="chef-hat" class="h-4 w-4" />
                    {data.difficulty}
                </span>
            </div>
        </div>
    </a>
</article>
