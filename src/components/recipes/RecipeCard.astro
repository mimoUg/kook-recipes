---
import Icon from '../ui/Icon.astro';
import {
    formatDate,
    getRecipeDate,
    getRecipeSlug,
    type Recipe,
} from '../../lib/recipes';

interface Props {
    recipe: Recipe;
    class?: string;
    showDate?: boolean;
}

const { recipe, class: className = '', showDate = true } = Astro.props;
const { data } = recipe;
const slug = getRecipeSlug(recipe);
const date = getRecipeDate(recipe);
const title = data.title || 'Untitled recipe';
const hasMeta = Boolean(data.totalTime || data.servings || data.difficulty);
---

<article
    class:list={['group h-full', className]}
    data-recipe-card
    data-title={title}
    data-description={data.description}
    data-categories={data.categories.join('|')}
    data-popular={String(data.popular)}
    data-ingredients={data.ingredients.join(' ')}
>
    <a href={`/recipes/${slug}`} class="flex h-full flex-col">
        <div
            class="relative aspect-[1.48] overflow-hidden rounded-xl bg-appGray-100 md:rounded-2xl xl:aspect-[1.15]"
        >
            {
                data.coverImage ? (
                    <img
                        src={data.coverImage}
                        alt={data.coverAlt || title}
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-[1.035]"
                    />
                ) : (
                    <div class="flex h-full w-full items-center justify-center text-appGray-400">
                        <Icon name="chef-hat" class="h-12 w-12" />
                    </div>
                )
            }

            {
                data.popular && (
                    <span class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-appAccent px-2.5 py-1.5 text-[10px] font-medium uppercase leading-none tracking-[0.08em] text-appText">
                        <Icon name="star" class="h-3 w-3" />
                        Popular
                    </span>
                )
            }
        </div>

        <div class="flex flex-1 flex-col pt-4 xl:pt-5">
            {
                showDate && date && (
                    <p class="text-xs font-medium leading-none tracking-[-0.02em] text-appGray-400 xl:text-sm">
                        {formatDate(date)}
                    </p>
                )
            }

            <div class="mt-2.5 flex items-start justify-between gap-3">
                <h3
                    class="text-lg font-medium leading-snug tracking-[-0.03em] text-appText group-hover:underline xl:text-2xl"
                >
                    {title}
                </h3>
                <span
                    class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded bg-[#F2F2F2] text-appText transition-colors group-hover:bg-appAccent xl:h-7 xl:w-7"
                    aria-hidden="true"
                >
                    <Icon name="external-link" class="h-3.5 w-3.5" />
                </span>
            </div>

            {
                data.description && (
                    <p class="mt-2 line-clamp-3 text-sm font-normal leading-[1.35] tracking-[-0.02em] text-appGray-500 xl:text-base">
                        {data.description}
                    </p>
                )
            }

            {
                hasMeta && (
                    <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 pt-4 text-xs font-medium text-appGray-400">
                        {data.totalTime && (
                            <span class="inline-flex items-center gap-1.5">
                                <Icon name="clock" class="h-3.5 w-3.5" />
                                {data.totalTime}
                            </span>
                        )}
                        {data.servings && (
                            <span class="inline-flex items-center gap-1.5">
                                <Icon name="users" class="h-3.5 w-3.5" />
                                {data.servings} servings
                            </span>
                        )}
                        {data.difficulty && (
                            <span class="inline-flex items-center gap-1.5">
                                <Icon name="chef-hat" class="h-3.5 w-3.5" />
                                {data.difficulty}
                            </span>
                        )}
                    </div>
                )
            }
        </div>
    </a>
</article>
