---
import Icon from '../ui/Icon.astro';

interface Props {
    class?: string;
    value?: string;
    placeholder?: string;
    id?: string;
}

const {
    class: className = '',
    value = '',
    placeholder = 'Search recipes',
    id = 'recipe-search',
} = Astro.props;
---

<form action="/recipes" method="get" class:list={[className]}>
    <label
        for={id}
        class="flex items-center gap-3 rounded-[48px] border border-appGray-100 bg-white/90 px-4 py-2 backdrop-blur transition-colors focus-within:border-appGray-300 md:px-6"
    >
        <Icon
            name="search"
            class="h-5 w-5 shrink-0 text-appText md:h-6 md:w-6"
        />
        <input
            id={id}
            type="search"
            name="s"
            value={value}
            placeholder={placeholder}
            autocomplete="off"
            class="w-full bg-transparent py-2.5 text-base font-normal text-appText outline-none placeholder:text-appText md:py-3 md:text-lg lg:text-xl"
        />
        <button
            type="submit"
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-appText text-white transition-colors hover:bg-appText/85 md:h-10 md:w-10"
        >
            <Icon name="arrow-right" class="h-4 w-4" />
            <span class="sr-only">Search</span>
        </button>
    </label>
</form>
