---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import BackToTop from '../components/layout/BackToTop.astro';
import { settings } from '../lib/settings';

interface Props {
    title: string;
    description?: string;
    image?: string;
    type?: 'website' | 'article';
    noindex?: boolean;
}

const {
    title,
    description = settings.siteDescription,
    image = settings.hero.image,
    type = 'website',
    noindex = false,
} = Astro.props;

const pageTitle =
    title === settings.siteTitle
        ? title
        : `${title} | ${settings.siteTitle}`;

const site = Astro.site ?? new URL('https://kook-recipes.vercel.app');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = image.startsWith('http') ? image : new URL(image, site).toString();

const adsenseClient = 'ca-pub-7025798228912049';
// The AdSense loader powers both Auto ads and manually placed ad units.
// Do not render it on noindex pages such as the 404 page.
const showAdsense = !noindex;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#0A2213" />
        <meta name="google-adsense-account" content={adsenseClient} />
        <meta
            name="p:domain_verify"
            content="1b04663c4f6cc8b9fd2da5fe499e76c8"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        {noindex && <meta name="robots" content="noindex, nofollow" />}
        {
            showAdsense && (
                <>
                    <link
                        rel="preconnect"
                        href="https://pagead2.googlesyndication.com"
                        crossorigin
                    />
                    <link
                        rel="preconnect"
                        href="https://googleads.g.doubleclick.net"
                        crossorigin
                    />
                    <script
                        is:inline
                        async
                        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
                        crossorigin="anonymous"
                    ></script>
                </>
            )
        }

        <meta property="og:type" content={type} />
        <meta property="og:site_name" content={settings.siteTitle} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:alt" content={settings.siteTitle} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@1,500;1,600&display=swap"
            rel="stylesheet"
        />
        <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    </head>
    <body>
        <a
            href="#main"
            class="sr-only z-[100] rounded-lg bg-white px-4 py-3 text-sm font-semibold text-appAccent focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
        >
            Skip to content
        </a>
        <div class="flex min-h-screen flex-col">
            <Header />
            <main id="main" class="flex flex-1 flex-col">
                <slot />
            </main>
            <Footer />
        </div>
        <BackToTop />

        <script>
            // Open links to other websites in a new tab without giving them
            // access to this page. Internal links stay in the same tab.
            const pageHost = window.location.hostname.replace(/^www\./, '');

            document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
                if (!/^https?:$/.test(link.protocol)) return;

                const linkHost = link.hostname.replace(/^www\./, '');
                if (!linkHost || linkHost === pageHost) return;

                link.target = '_blank';
                const rel = new Set(link.rel.split(/\s+/).filter(Boolean));
                rel.add('noopener');
                rel.add('noreferrer');
                link.rel = Array.from(rel).join(' ');
            });
        </script>
    </body>
</html>
